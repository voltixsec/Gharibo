# GHARIBO-V1 serving - environment configuration (copy to .env and fill in).
# ALL configuration is environment-only. No secrets are committed.

# Served model identity (OpenAI-compatible `model` field + /health).
GHARIBO_MODEL_ID=GHARIBO-V1

# Adapter source: a LOCAL directory/file OR a remote URL. Provide exactly one.
# The adapter is verified by SHA256 BEFORE loading; an unverified adapter is refused.
GHARIBO_ADAPTER_PATH=/app/adapter
# GHARIBO_ADAPTER_URL=https://your-bucket/gharibo-v1-adapter

# Expected adapter SHA256. Defaults to the accepted GHARIBO-V1 adapter identity.
# Override only when you have a verified, re-issued adapter artifact.
GHARIBO_ADAPTER_SHA256=5d192d843af72298f5080f4ebe9fd77e3b47fa6c1abf46064706d091b80f7c22

# Base model used for serving. Leave unset to use the adapter's own trained base
# (unsloth/gpt-oss-20b-unsloth-bnb-4bit) so the exact adapter is loaded without
# re-basing. Overriding changes model identity and is not the accepted config.
# GHARIBO_BASE_MODEL=unsloth/gpt-oss-20b-unsloth-bnb-4bit

# Request auth. If set, POST /v1/chat/completions requires `Authorization: Bearer <key>`.
# GET /health is never gated (it exposes no secrets).
GHARIBO_API_KEY=replace-with-a-strong-secret

# Device / precision. The 4-bit base is the default serving path (memory-efficient,
# identity-preserving). Set GHARIBO_LOAD_IN_4BIT=false only with a >=48GB GPU.
GHARIBO_DEVICE=auto
GHARIBO_LOAD_IN_4BIT=true

# HTTP port.
PORT=8000

# HuggingFace token - only if required to pull a gated base model.
# HF_TOKEN=

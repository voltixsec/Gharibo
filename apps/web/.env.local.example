# Database path (relative to apps/web)
DATABASE_PATH=../../data/gharibo.db

# Python service URLs
TRAINER_URL=http://127.0.0.1:8100
INFERENCE_URL=http://127.0.0.1:8101
RESEARCH_URL=http://127.0.0.1:8102

# Provider API keys — set the ACTUAL key values here.
# The DB stores only the env var NAME (api_key_ref), never the raw key.
# Example: provider with api_key_ref="OPENAI_API_KEY" → reads this env var at call time.
# OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# TOGETHER_API_KEY=your-key-here
# GROQ_API_KEY=gsk_your-key-here

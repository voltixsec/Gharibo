{
  "name": "gharibo-ai-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "vitest run --root apps/web",
    "docs:validate": "node scripts/validate-docs.mjs && node scripts/master/validate-master-state.mjs",
    "master:generate": "node scripts/master/generate-master-state.mjs",
    "master:validate": "node scripts/master/validate-master-state.mjs",
    "preview:gold": "vite-node --config apps/web/vitest.config.ts scripts/training/preview-gold.ts",
    "verify:m2": "node scripts/verify-m2.mjs",
    "verify:m3a": "node scripts/verify-m3a.mjs --check",
    "verify:all": "npm run verify:m2 -- --check && npm run verify:m3a && npm run qualify:check",
    "qualify:render": "node scripts/qualify/qualify-kaggle-env.mjs",
    "qualify:check": "node scripts/qualify/qualify-kaggle-env.mjs --check && node scripts/qualify/check-qualify-harness.mjs",
    "qualify:smoke": "python scripts/qualify/smoke-fresh-process.py",
    "dev:services": "concurrently \"npm run dev:trainer\" \"npm run dev:inference\" \"npm run dev:research\"",
    "dev:trainer": "cd services/trainer && python -m uvicorn main:app --port 8100 --reload",
    "dev:inference": "cd services/inference && python -m uvicorn main:app --port 8101 --reload",
    "dev:research": "cd services/research && python -m uvicorn main:app --port 8102 --reload",
    "issue:gold": "node scripts/training/issue-gold.mjs",
    "kaggle:prepare": "node scripts/training/prepare-kaggle-start.mjs",
    "build:dec0030": "node scripts/training/build-dec0030-acceptance.mjs --check",
    "verify:result": "python scripts/training/verify-kaggle-result.py",
    "eval:audit:auth": "node scripts/eval/build-dec0032-authorization.mjs --check",
    "eval:audit:blocker": "node scripts/eval/build-dec0033-blocker.mjs --check",
    "eval:audit:launch": "node scripts/eval/build-dec0034-launch.mjs --check",
    "eval:audit:relaunch": "node scripts/eval/build-dec0035-relaunch.mjs --check",
    "eval:audit:leakage": "python scripts/eval/leakage-audit.py --check",
    "eval:verify": "node scripts/eval/verify-evaluation-state.mjs",
    "eval:render": "node scripts/eval/build-eval-kernel.mjs",
    "eval:check": "node scripts/eval/build-eval-kernel.mjs --check && node scripts/eval/check-eval-kernel.mjs",
    "eval:kernel:runtime": "python scripts/eval/verify-eval-kernel-runtime.py",
    "eval:launch:evidence": "python scripts/eval/verify-eval-failure-evidence.py --log gharibo-eval-001-fec22ca2.log",
    "eval:bundle": "node scripts/eval/prepare-eval-launch.mjs",
    "eval:bundle:verify": "python scripts/eval/verify-eval-bundle.py",
    "verify:eval": "npm run eval:audit:auth && npm run eval:audit:blocker && npm run eval:audit:launch && npm run eval:audit:relaunch && npm run eval:audit:escalation && npm run eval:audit:attempt4:auth && npm run eval:audit:attempt4:launch && npm run eval:audit:attempt4:failure && npm run eval:audit:leakage && npm run eval:verify && npm run eval:gate:attempt4 && npm run eval:check && npm run eval:kernel:runtime && npm run eval:bundle:verify",
    "eval:audit:escalation": "node scripts/eval/build-dec0036-escalation.mjs --check",
    "eval:audit:attempt4:auth": "node scripts/eval/build-dec0038-authorization.mjs --check",
    "eval:audit:attempt4:launch": "node scripts/eval/build-dec0039-launch.mjs --check",
    "eval:audit:attempt4:failure": "node scripts/eval/build-dec0040-failure.mjs --check",
    "eval:gate:attempt4": "node scripts/eval/check-attempt4-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^9.0.1",
    "next": "^14.2.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "lucide-react": "^0.417.0"
  }
}

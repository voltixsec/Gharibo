# GHARIBO AI LAB Environment Variables

# Database
DATABASE_PATH=./data/gharibo.db

# Python Service URLs
TRAINER_URL=http://127.0.0.1:8100
INFERENCE_URL=http://127.0.0.1:8101
RESEARCH_URL=http://127.0.0.1:8102

# CORS for the Python services (comma-separated origins; wildcard is not used).
# Defaults to the local frontend origins if unset.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Provider API Keys (referenced by name in DB, values stored in env only)
# Example: if a provider has api_key_ref="OPENAI_API_KEY", set it here:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# TOGETHER_API_KEY=...
# GROQ_API_KEY=...

# Never commit .env.local — it contains real secrets.
# The DB stores only the env var NAME (e.g. "OPENAI_API_KEY"), never the raw key.
